<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D1A"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="IKWA·NEWERA"
            android:textColor="#BF5FFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● OFFLINE"
            android:textColor="#666666"
            android:textSize="12sp"
            android:background="@drawable/badge_bg"
            android:padding="6dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A1A2E"
        android:layout_marginBottom="20dp" />

    <!-- Server URL -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SERVER URL"
        android:textColor="#7A7A9D"
        android:textSize="10sp"
        android:letterSpacing="0.2"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etServerUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ws://192.168.1.1:4101"
        android:textColor="#BF5FFF"
        android:textColorHint="#333355"
        android:background="@drawable/input_bg"
        android:padding="14dp"
        android:textSize="14sp"
        android:inputType="textUri"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="CONNECT"
        android:textColor="#BF5FFF"
        android:background="@drawable/btn_outline"
        android:letterSpacing="0.15"
        android:textSize="13sp"
        android:layout_marginBottom="20dp" />

    <!-- Device Admin -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg"
        android:padding="14dp"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="// DEVICE ADMIN"
            android:textColor="#7A7A9D"
            android:textSize="10sp"
            android:letterSpacing="0.2"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvAdminStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Device Admin: NONAKTIF"
            android:textColor="#FF3355"
            android:textSize="13sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnAdmin"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="AKTIFKAN ADMIN"
            android:textColor="#BF5FFF"
            android:background="@drawable/btn_outline"
            android:letterSpacing="0.1"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Log -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="// LOG"
        android:textColor="#7A7A9D"
        android:textSize="10sp"
        android:letterSpacing="0.2"
        android:layout_marginBottom="6dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/card_bg">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#9B59B6"
            android:textSize="11sp"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:text="Menunggu koneksi..." />
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RECEIVER · TARGET"
        android:textColor="#2A2A4A"
        android:textSize="10sp"
        android:gravity="center"
        android:letterSpacing="0.3"
        android:paddingTop="12dp" />

</LinearLayout>
